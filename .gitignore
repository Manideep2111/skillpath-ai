# Python
__pycache__/
*.py[cod]
*$py.class
*.bak
*.swp
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local databases (Strictly exclude all SQLite database files)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Generated exports and test artifacts
data/generated/*
!data/generated/.gitkeep
data/exports/*
!data/exports/.gitkeep
data/anomalies/*
!data/anomalies/.gitkeep

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
!frontend/.env.example
